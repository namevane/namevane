{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-pins",
    "allow-upsert-pin",
    "allow-delete-pin",
    "allow-set-pin-enabled",
    "allow-app-about",
    "allow-open-project-page",
    "allow-runtime-settings",
    "allow-set-language",
    "allow-set-run-in-background",
    "allow-set-open-at-login",
    "allow-export-pins",
    "allow-import-pins",
    "allow-install-update"
  ]
}
